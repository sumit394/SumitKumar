@page "/bingo"
@layout PortfolioLayout
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>Diwali 2026</PageTitle>

<section class="bingo-stage" aria-label="Bingo game">
    <div class="bingo-content">
        <header class="bingo-heading">
            <div>
                <p class="bingo-kicker">Every ticket a new light</p>
                <h1>Bingo</h1>
            </div>
            <p class="bingo-progress">@_drawnNumbers.Count <span>/ @MaximumNumber drawn</span></p>
        </header>

        <div class="bingo-board">
            <div class="bingo-playfield" aria-live="polite" aria-atomic="true">
                @if (_currentNumbers.Length > 0)
                {
                    <div class="bingo-number-pair" aria-label="Numbers drawn">
                        @for (var index = 0; index < _currentNumbers.Length; index++)
                        {
                            var number = _currentNumbers[index];
                            <div class="bingo-number-box @(_isRolling ? "is-rolling" : null)" @key="number">
                                <span>DRAW @(index + 1)</span>
                                <strong>@number</strong>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bingo-ready">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                        <p>Ready to play</p>
                    </div>
                }
            </div>

            <section class="bingo-called" aria-label="Overall number status">
                <div class="called-heading">
                    <h2>Number status</h2>
                    <span>@_drawnNumbers.Count / @MaximumNumber</span>
                </div>
                <ol class="called-list">
                    @foreach (var number in Enumerable.Range(1, MaximumNumber))
                    {
                        var isDrawn = _drawnNumbers.Contains(number);
                        <li @key="number" class="@(isDrawn ? "is-drawn" : null)" aria-label="@($"{number}: {(isDrawn ? "drawn" : "not drawn")}")">@number</li>
                    }
                </ol>
            </section>
        </div>

        <div class="bingo-controls">
            <button class="bingo-next" type="button" @onclick="DrawNextAsync" disabled="@(_isRolling || _drawnNumbers.Count == MaximumNumber)">
                <i class="bi bi-skip-forward-fill" aria-hidden="true"></i>
                <span>@(_drawnNumbers.Count == MaximumNumber ? "Complete" : "Next")</span>
            </button>
            <button class="bingo-reset" type="button" @onclick="ResetGame">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span>Reset</span>
            </button>
        </div>
    </div>
</section>

@code {
    private const int MaximumNumber = 99;
    private const int NumbersPerDraw = 2;
    private const int RevealDurationMilliseconds = 1500;
    private readonly List<int> _drawnNumbers = new(MaximumNumber);
    private int[] _currentNumbers = [];
    private bool _isRolling;
    private int _drawGeneration;

    private async Task DrawNextAsync()
    {
        if (_isRolling || _drawnNumbers.Count == MaximumNumber)
        {
            return;
        }

        var remainingNumbers = Enumerable.Range(1, MaximumNumber)
            .Where(number => !_drawnNumbers.Contains(number))
            .ToList();
        var numbersToDraw = new List<int>(Math.Min(NumbersPerDraw, remainingNumbers.Count));

        for (var index = 0; index < NumbersPerDraw && remainingNumbers.Count > 0; index++)
        {
            var selectedIndex = Random.Shared.Next(remainingNumbers.Count);
            numbersToDraw.Add(remainingNumbers[selectedIndex]);
            remainingNumbers.RemoveAt(selectedIndex);
        }

        _currentNumbers = numbersToDraw.ToArray();
        _drawnNumbers.AddRange(_currentNumbers);
        _isRolling = true;
        var generation = ++_drawGeneration;

        await Task.Delay(RevealDurationMilliseconds);

        if (generation == _drawGeneration)
        {
            _isRolling = false;
        }
    }

    private void ResetGame()
    {
        _drawGeneration++;
        _drawnNumbers.Clear();
        _currentNumbers = [];
        _isRolling = false;
    }
}
